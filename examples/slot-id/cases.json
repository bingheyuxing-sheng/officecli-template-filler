    "collision_suffix_rule": {
      "kind": "rule",
      "rule": "On a 12-hex collision, sort canonical strings lexicographically; the first keeps the bare id, subsequent ones append -c2, -c3. The result must be reproducible.",
      "example": ["S_d6df35f1e6cd", "S_d6df35f1e6cd-c2", "S_d6df35f1e6cd-c3"]
    }
