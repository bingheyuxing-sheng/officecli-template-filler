{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://office-skill/v4.0/schemas/content_plan-4.0.schema.json",
  "title": "ContentPlan 4.0",
  "description": "Content planning contract. Contains sections, sources and facts; contains no DOCX execution operations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "template_id", "sections", "facts", "completeness"],
  "properties": {
    "schema_version": { "const": "4.0" },
    "plan_id": { "type": "string", "pattern": "^CP_[0-9A-Za-z_-]{1,32}$" },
    "template_id": { "type": "string", "pattern": "^T_[0-9a-f]{12}$" },
    "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } },
    "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
    "completeness": { "$ref": "#/$defs/completeness" },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } }
  },
  "$defs": {
    "slot_id": { "type": "string", "pattern": "^S_[0-9a-f]{12}(-c[2-9][0-9]*)?$" },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "purpose", "target_slots"],
      "properties": {
        "section_id": { "type": "string", "pattern": "^SEC_[0-9A-Za-z_-]{1,32}$" },
        "purpose": { "type": "string", "minLength": 1 },
        "target_slots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/slot_id" } },
        "requirements": { "$ref": "#/$defs/requirements" },
        "source_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "fact_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^F_[0-9A-Za-z_-]{1,32}$" } }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "must_include": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "target_length": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["min", "max"],
              "properties": {
                "min": { "type": "integer", "minimum": 0 },
                "max": { "type": "integer", "minimum": 0 }
              }
            }
          ]
        },
        "min_sources": { "type": "integer", "minimum": 0 }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "label", "value", "unit", "source", "verification_status", "used_by_slots"],
      "properties": {
        "fact_id": { "type": "string", "pattern": "^F_[0-9A-Za-z_-]{1,32}$" },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "number"] },
        "unit": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "verification_status": { "enum": ["VERIFIED", "UNVERIFIED", "MODEL_GENERATED"] },
        "used_by_slots": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slot_id" } }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_slots", "optional_slots", "allow_missing"],
      "properties": {
        "required_slots": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slot_id" } },
        "optional_slots": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slot_id" } },
        "allow_missing": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot_id", "reason"],
            "properties": {
              "slot_id": { "$ref": "#/$defs/slot_id" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  }
}
