{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://office-skill/v4.0/schemas/error_code_registry-4.0.schema.json",
  "title": "ErrorCodeRegistry 4.0",
  "description": "Single registry for error and warning codes with severity, retry, rollback and human-intervention semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "codes"],
  "properties": {
    "schema_version": { "const": "4.0" },
    "codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "retryable",
          "rollback_required",
          "human_intervention",
          "owner",
          "message_template",
          "introduced_in"
        ],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
          "severity": { "enum": ["low", "medium", "high", "blocking"] },
          "retryable": { "type": "boolean" },
          "rollback_required": { "type": "boolean" },
          "human_intervention": { "type": "boolean" },
          "owner": { "enum": ["AGENT01", "AGENT02", "AGENT03", "AGENT04", "AGENT05", "AGENT06", "AGENT07", "CORE"] },
          "message_template": { "type": "string", "minLength": 1 },
          "introduced_in": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
