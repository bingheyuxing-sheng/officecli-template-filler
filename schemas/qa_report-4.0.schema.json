{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://office-skill/v4.0/schemas/qa_report-4.0.schema.json",
  "title": "QAReport 4.0",
  "description": "Independent verification report. Required checks are policy-owned; missing checks can never be PASSED.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "status",
    "task_mode",
    "gate_mode",
    "policy_source",
    "required_checks",
    "executed_checks",
    "missing_checks",
    "checks",
    "issues",
    "coverage_gaps",
    "repairs",
    "final"
  ],
  "properties": {
    "schema_version": { "const": "4.0" },
    "task_id": { "type": "string", "pattern": "^TASK_[0-9A-Za-z_-]{1,64}$" },
    "status": { "enum": ["PASSED", "FAILED", "PENDING_HUMAN_REVIEW", "UNVERIFIED"] },
    "task_mode": { "enum": ["GENERATE", "REPAIR", "REVIEW", "EXCEL_GENERATE"] },
    "gate_mode": { "enum": ["STRICT", "STANDARD", "REPLICA"] },
    "policy_source": { "type": "string", "minLength": 1 },
    "required_checks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/check_id" } },
    "executed_checks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/check_id" } },
    "missing_checks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/check_id" } },
    "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
    "coverage_gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "repairs": { "type": "array", "items": { "$ref": "#/$defs/repair" } },
    "final": { "$ref": "#/$defs/final" },
    "transaction": { "type": "object" }
  },
  "$defs": {
    "check_id": {
      "enum": [
        "PACKAGE",
        "FORMAT",
        "FIDELITY",
        "CONTENT",
        "DATA",
        "VISUAL_PAGE_COUNT",
        "VISUAL_PIXEL",
        "OCR",
        "REVIEW_INTEGRITY",
        "EXCEL_FORMULA"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string", "minLength": 1 },
        "input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "detail": { "type": "string" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "required", "status", "evidence"],
      "properties": {
        "check_id": { "$ref": "#/$defs/check_id" },
        "required": { "type": "boolean" },
        "status": { "enum": ["PASSED", "FAILED", "PENDING_HUMAN_REVIEW", "UNVERIFIED", "SKIPPED"] },
        "evidence": { "$ref": "#/$defs/evidence" },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "location", "detail", "blocking"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["high", "medium", "low"] },
        "location": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" },
        "check_id": { "$ref": "#/$defs/check_id" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "detail"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["medium", "low"] },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repair_id", "issue_code", "action", "applied", "recheck"],
      "properties": {
        "repair_id": { "type": "string", "pattern": "^REP_[0-9A-Za-z_-]{1,32}$" },
        "issue_code": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "revision_id": { "type": ["string", "null"] },
        "applied": { "type": "boolean" },
        "recheck": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["PASSED", "FAILED", "UNVERIFIED", "SKIPPED"] },
            "report_ref": { "type": ["string", "null"] }
          }
        }
      }
    },
    "final": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_for_commit", "reasons"],
      "properties": {
        "eligible_for_commit": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
