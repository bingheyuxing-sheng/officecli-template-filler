{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa_report.schema.json",
  "title": "QAReport",
  "description": "Unified QA report for DOCX and XLSX deliverables. Every section exposes structured issues so callers can branch on codes instead of parsing prose.",
  "type": "object",
  "required": ["status", "passed", "issues", "coverage_gaps", "unverified_count"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["PASSED", "FAILED", "PENDING_HUMAN_REVIEW", "UNVERIFIED"],
      "description": "PASSED = no high-severity issues (medium/low are in warnings); FAILED = at least one high-severity issue; PENDING_HUMAN_REVIEW = only intentional placeholder residue awaiting a human decision; UNVERIFIED = no high-severity issue but one or more checks could not run."
    },
    "passed": {
      "type": "boolean",
      "description": "True only when status is PASSED (warnings may still be present)."
    },
    "passed_or_pending": {
      "type": "boolean",
      "description": "True when the file is structurally sound and either fully passed or awaiting human review."
    },
    "comparison_profile": {
      "type": "string",
      "enum": ["REPLICA", "STYLE_GUIDE"],
      "description": "STYLE_GUIDE aligns by semantic anchors for GENERATE; REPLICA preserves template order for REPAIR/REVIEW."
    },
    "alignment": {
      "type": "object",
      "description": "Paragraph/table matching summary; unmatched items are NEW_CONTENT/NEW_TABLE, not drift.",
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "description": "Medium/low severity advisory issues that do not block delivery.",
      "items": {
        "type": "object",
        "required": ["code", "location", "detail", "severity"],
        "properties": {
          "code": { "type": "string" },
          "location": { "type": "string" },
          "detail": { "type": "string" },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },
    "warning_count": { "type": "integer", "minimum": 0 },
    "issues": {
      "type": "array",
      "description": "Flattened structured issues from every section.",
      "items": {
        "type": "object",
        "required": ["code", "location", "detail", "severity"],
        "properties": {
          "code": { "type": "string" },
          "location": { "type": "string" },
          "detail": { "type": "string" },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },
    "coverage_gaps": {
      "type": "array",
      "description": "Checks that could not be performed, never reported as passed.",
      "items": { "type": "string" }
    },
    "unverified_count": { "type": "integer", "minimum": 0 },
    "hard_failure_count": { "type": "integer", "minimum": 0 },
    "pending_human_review_count": { "type": "integer", "minimum": 0 },
    "package_integrity": {
      "type": "object",
      "required": ["passed", "inspected_parts_count", "xml_parse_errors", "dangling_relationships", "unresolved_rids", "duplicate_para_ids", "duplicate_docpr_ids", "missing_space_preserve", "image_integrity"],
      "properties": {
        "passed": { "type": "boolean" },
        "issues": { "type": "array", "items": { "type": "object" } },
        "structured_issues": { "type": "array", "items": { "type": "object" } },
        "inspected_parts_count": { "type": "integer" },
        "xml_parse_errors": { "type": "array", "items": { "type": "string" } },
        "dangling_relationships": { "type": "array", "items": { "type": "string" } },
        "unresolved_rids": { "type": "array", "items": { "type": "string" } },
        "duplicate_para_ids": { "type": "array", "items": { "type": "string" } },
        "duplicate_docpr_ids": { "type": "array", "items": { "type": "string" } },
        "missing_space_preserve": { "type": "integer" },
        "image_integrity": { "type": "object" }
      }
    },
    "format_and_text_qa": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "issues": { "type": "array", "items": { "type": "object" } },
        "size_anomalies": { "type": "array" },
        "font_anomalies": { "type": "array" },
        "table_style_anomalies": { "type": "array" },
        "pagination_anomalies": { "type": "array" },
        "text_residuals": { "type": "array" },
        "size_baseline_source": { "type": "string" },
        "template_sizes": { "type": "array" },
        "template_fonts": { "type": "array" }
      }
    },
    "visual_qa": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "issues": { "type": "array", "items": { "type": "object" } },
        "printable_width_twips": { "type": "integer" },
        "layout_warnings": { "type": "array", "items": { "type": "string" } },
        "pdf_rendered": { "type": "boolean" },
        "pdf_path": { "type": ["string", "null"] },
        "reference_pdf_path": { "type": ["string", "null"] },
        "pdf_conversion_errors": { "type": "object", "additionalProperties": { "type": "string" } },
        "page_diff_available": { "type": "boolean" },
        "page_diff_error": { "type": ["string", "null"] },
        "page_diff_coverage": {
          "type": "object",
          "required": ["pages_compared", "pages_total", "partial"],
          "properties": {
            "pages_compared": { "type": "integer", "minimum": 0 },
            "pages_total": { "type": "integer", "minimum": 0 },
            "partial": { "type": "boolean" }
          }
        },
        "page_count_mismatch": {
          "type": ["array", "null"],
          "items": { "type": "integer" },
          "minItems": 2,
          "maxItems": 2
        },
        "page_diffs": { "type": "array", "items": { "type": "array" } },
        "font_availability": { "type": "object" },
        "layout_fingerprint": { "type": ["object", "null"] },
        "coverage_gaps": { "type": "array", "items": { "type": "string" } },
        "unverified_count": { "type": "integer", "minimum": 0 }
      }
    },
    "review_qa": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "track_changes_enabled": { "type": "boolean" },
        "revision_count": { "type": "integer" },
        "comment_count": { "type": "integer" },
        "issues": { "type": "array", "items": { "type": "object" } }
      }
    },
    "excel_qa": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "issues": { "type": "array", "items": { "type": "object" } },
        "coverage_gaps": { "type": "array", "items": { "type": "string" } },
        "unverified_count": { "type": "integer" },
        "recalculation": { "type": "object" }
      }
    }
  }
}
