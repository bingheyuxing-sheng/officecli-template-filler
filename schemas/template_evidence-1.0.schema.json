{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://office-skill/w4/schemas/template_evidence-1.0.schema.json",
  "title": "TemplateEvidence 1.0",
  "description": "Template understanding evidence produced by template_gate.analyzer.build_analysis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "template_sha256",
    "template_name",
    "spec_schema_version",
    "spec_digest",
    "fingerprint_ref",
    "analysis_version",
    "parser_version",
    "policy_version",
    "task_type",
    "evidence",
    "summary",
    "evidence_digest"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "analysis_id": { "type": "string", "pattern": "^analysis_[0-9a-f]{12}$" },
    "template_sha256": { "$ref": "#/$defs/sha256" },
    "template_name": { "type": "string", "minLength": 1 },
    "spec_schema_version": { "type": "string", "minLength": 1 },
    "spec_digest": { "$ref": "#/$defs/sha256" },
    "fingerprint_ref": { "$ref": "#/$defs/fingerprint_ref" },
    "analysis_version": { "type": "string", "minLength": 1 },
    "parser_version": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "task_type": {
      "enum": ["GENERATE", "REPAIR", "REFORMAT", "REVIEW", "PROOFREAD", "EXCEL_GENERATE", "POLISH", "MERGE"]
    },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence_record" } },
    "summary": { "$ref": "#/$defs/summary" },
    "evidence_digest": { "$ref": "#/$defs/sha256" },
    "supplements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "kind", "name"],
        "properties": {
          "sha256": { "type": ["string", "null"] },
          "kind": { "type": "string" },
          "name": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fingerprint_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint_id", "structural_hash", "style_hash", "protected_hash", "layout_hash"],
      "properties": {
        "fingerprint_id": { "type": "string", "pattern": "^FP_[0-9]{3,}$" },
        "structural_hash": { "$ref": "#/$defs/sha256" },
        "style_hash": { "$ref": "#/$defs/sha256" },
        "protected_hash": { "$ref": "#/$defs/sha256" },
        "layout_hash": { "$ref": "#/$defs/sha256" },
        "baseline_path": { "type": ["string", "null"] }
      }
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "object_id",
        "location",
        "property",
        "value",
        "source",
        "evidence_type",
        "verification_status",
        "task_relevant",
        "blocking",
        "severity",
        "detail",
        "required_materials",
        "resolutions",
        "resolved_at"
      ],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^ev_[0-9a-f]{12}$" },
        "object_id": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "property": { "type": "string", "minLength": 1 },
        "value": {},
        "source": { "type": "string", "minLength": 1 },
        "evidence_type": {
          "enum": ["xml_node", "style_definition", "computed_property", "parser_rule", "user_statement", "reference_document"]
        },
        "verification_status": { "enum": ["VERIFIED", "UNVERIFIED", "AMBIGUOUS", "CONFLICT"] },
        "task_relevant": { "type": "boolean" },
        "blocking": { "type": "boolean" },
        "severity": { "enum": ["blocking", "warning", "info"] },
        "detail": { "type": "string" },
        "required_materials": { "type": "array", "items": { "type": "string" } },
        "resolutions": { "type": "array", "items": { "type": "object" } },
        "resolved_at": { "type": ["string", "null"] }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified",
        "unverified",
        "ambiguous",
        "conflict",
        "total",
        "task_relevant",
        "blocking",
        "coverage"
      ],
      "properties": {
        "verified": { "type": "integer", "minimum": 0 },
        "unverified": { "type": "integer", "minimum": 0 },
        "ambiguous": { "type": "integer", "minimum": 0 },
        "conflict": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "task_relevant": { "type": "integer", "minimum": 0 },
        "blocking": { "type": "integer", "minimum": 0 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
