{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://office-skill/w4/schemas/template_gate_record-1.0.schema.json",
  "title": "TemplateGateRecord 1.0",
  "description": "Persistent confirmation record binding a template analysis to a user confirmation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "template_sha256",
    "template_name",
    "spec_schema_version",
    "spec_digest",
    "fingerprint_ref",
    "analysis_version",
    "parser_version",
    "policy_version",
    "task_type",
    "evidence_digest",
    "evidence_summary",
    "blocking_count",
    "status",
    "user_confirmed",
    "confirmed_at",
    "confirmed_by",
    "user_statement",
    "confirmation_token",
    "review_token_digest",
    "expires_at",
    "supplements",
    "invalidated_reason",
    "created_at",
    "updated_at",
    "executions"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "gate_id": { "type": "string", "pattern": "^gate_[0-9a-f]{12}$" },
    "template_sha256": { "$ref": "#/$defs/sha256" },
    "template_name": { "type": "string", "minLength": 1 },
    "spec_schema_version": { "type": "string", "minLength": 1 },
    "spec_digest": { "$ref": "#/$defs/sha256" },
    "fingerprint_ref": { "$ref": "#/$defs/fingerprint_ref" },
    "analysis_version": { "type": "string", "minLength": 1 },
    "parser_version": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "task_type": { "enum": ["GENERATE", "REPAIR", "REFORMAT", "REVIEW", "PROOFREAD", "EXCEL_GENERATE", "POLISH", "MERGE"] },
    "evidence_digest": { "$ref": "#/$defs/sha256" },
    "evidence_summary": { "type": "object" },
    "blocking_count": { "type": "integer", "minimum": 0 },
    "status": {
      "enum": ["DISCOVERING", "ANALYZING", "VALIDATING", "BLOCKED", "WAITING_USER_INPUT", "READY_FOR_REVIEW", "CONFIRMED", "EXECUTING", "INVALIDATED", "REJECTED"]
    },
    "user_confirmed": { "type": "boolean" },
    "confirmed_at": { "type": ["string", "null"] },
    "confirmed_by": { "type": ["string", "null"] },
    "user_statement": { "type": ["string", "null"] },
    "confirmation_token": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "review_token_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "expires_at": { "type": ["string", "null"] },
    "supplements": { "type": "array", "items": { "type": "object" } },
    "resolved_evidence": { "type": "array", "items": { "type": "object" } },
    "invalidated_reason": { "type": ["string", "null"] },
    "created_at": { "type": ["string", "null"] },
    "updated_at": { "type": ["string", "null"] },
    "executions": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fingerprint_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint_id", "structural_hash", "style_hash", "protected_hash", "layout_hash"],
      "properties": {
        "fingerprint_id": { "type": "string", "pattern": "^FP_[0-9]{3,}$" },
        "structural_hash": { "$ref": "#/$defs/sha256" },
        "style_hash": { "$ref": "#/$defs/sha256" },
        "protected_hash": { "$ref": "#/$defs/sha256" },
        "layout_hash": { "$ref": "#/$defs/sha256" },
        "baseline_path": { "type": ["string", "null"] }
      }
    }
  }
}
